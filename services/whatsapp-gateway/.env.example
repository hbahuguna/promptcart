# Copy this file to .env and fill in your values.
# The .env file is git-ignored — never commit secrets.

# Token WhatsApp uses to verify your webhook URL.
# Set the same value in the Meta Developer Console → Webhooks → Verify Token.
VERIFY_TOKEN=my_secure_verify_token

# Redis connection URL (overridden by docker-compose to point at the redis service)
REDIS_URL=redis://localhost:6379
